# PostgreSQL (docker compose + local prisma CLI)
POSTGRES_USER=my_user
POSTGRES_PASSWORD=my_password
POSTGRES_DB=my_database

# For pnpm on the host (localhost). In compose, api/migrate override host to `postgres`.
DATABASE_URL=postgresql://my_user:my_password@localhost:5432/my_database

CLIENT_URL=http://localhost:3000
JWT_SECRET_CODE=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Auth cookies: set true on HTTPS. If unset, secure=true when NODE_ENV=production.
# COOKIE_SECURE=true

# docker-compose.prod.yml — public site URL (no trailing slash). Rebuild `web` after change.
# PUBLIC_ORIGIN=http://your-server-ip
# PUBLIC_ORIGIN=https://finance.example.com

# Optional web push (rebuild `web` if NEXT_PUBLIC_VAPID_PUBLIC_KEY changes)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Optional
# PORT=3000

# Mail (optional for /health; required for auth email flows)
# MAIL_HOST=
# MAIL_PORT=465
# MAIL_USER=
# MAIL_PASS=
# MAIL_FROM="Finance Track <no-reply@example.com>"
# APP_URL=http://localhost:3000
